# Public hostname of the Fly app (no scheme).
# Prefer FEEDGEN_HOSTNAME — plain HOSTNAME collides with the OS/shell variable.
FEEDGEN_HOSTNAME=anarchist-bluesky-feed.fly.dev

# did:web for this feedgen service (defaults to did:web:$FEEDGEN_HOSTNAME)
SERVICE_DID=did:web:anarchist-bluesky-feed.fly.dev

# Feed record URI after publish_feed.py
FEED_URI=at://did:plc:REPLACE/app.bsky.feed.generator/mutualism

# Bluesky credentials for publish_feed.py only (use an app password)
HANDLE=chriscarrollsmith.bsky.social
PASSWORD=

RECORD_NAME=mutualism
DISPLAY_NAME=Mutualism
DESCRIPTION=Proudhonian mutualism: reciprocity, possession, mutual credit
AVATAR_PATH=./assets/proudhon.jpg

# Runtime knobs
IGNORE_REPLY_POSTS=true
IGNORE_ARCHIVED_POSTS=true
POST_RETENTION_DAYS=7
# Soft author priors: bare ambiguous terms after N decider keeps and
# zero decider rejections in the window. Regex matches do not count.
SOFT_PRIOR_MIN_KEEPS=3
SOFT_PRIOR_WINDOW_DAYS=30
DATABASE_PATH=/data/feed_database.db
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
PORT=8080
LOG_LEVEL=INFO

# Feed ranking among indexed matches: indexed | created | engagement
RANKING_MODE=indexed
# Comma-separated substrings; matching posts are not indexed (empty = off)
MUTED_KEYWORDS=

# Content filter: Perplexity decider via the OpenRouter Decisions API.
# Keeps or rejects every post that passes the regex floor. Fail closed when
# enabled without a key or when a request errors.
DECISION_ENABLED=true
DECISION_MODEL=perplexity/pplx-decider-v1.1-27b
DECISION_KEEP_MIN=0.5
DECISION_TIMEOUT_S=8
OPENROUTER_API_KEY=
DECISION_API_URL=https://openrouter.ai/api/alpha/decisions

# Optional DeepSeek client for scripts/llm_label_judge.py (not the ingest path).
DEEPSEEK_API_KEY=
